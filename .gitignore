# Design mocks rendered from live runtime state. `.state/` is ignored above, so
# anything derived from it (real provider names, percentages, reset timestamps,
# the publishing machine's hostname) must not reach a public remote either.
# Kept on disk as durable design material, deliberately untracked.
app/design-system/mocks/

# Runtime logs (AGENTS.md: gitignored .logs/<project>.log, never scattered
# outside the project and never committed).
.logs/

# The operator's recorded TestFlight group confirmation. Deliberately local:
# committing it would hand every clone a standing authority to distribute
# builds, which is the one decision this repo requires a human to make.
.release/tester-group.json

# uv writes this when the release bridge's `uv run` shebang resolves an
# interpreter. It pins one exact version, while pyproject.toml only requires
# >=3.10; committing it would force every clone onto a version the project
# does not ask for.
.python-version
