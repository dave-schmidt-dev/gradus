#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

case "${1:-}" in
  --prepare-only)
    [[ $# -eq 1 ]] || {
      echo "release-testflight: --prepare-only takes no extra arguments" >&2
      exit 64
    }
    exec "$SCRIPT_DIR/prepare-testflight-candidate"
    ;;
  --upload)
    [[ $# -eq 1 ]] || {
      echo "release-testflight: --upload takes no extra arguments" >&2
      exit 64
    }
    exec "$SCRIPT_DIR/deploy-testflight" --attended
    ;;
  *)
    echo "usage: app/release-testflight --prepare-only|--upload" >&2
    exit 64
    ;;
esac
