{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/layout/**",
              "components/mobile/**",
              "ui_kits/**",
              "ui_kits/gradus-cli/**",
              "ui_kits/gradus-mac/**",
              "ui_kits/gradus-mobile/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|children|onClick|title|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, children, onClick, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:prominent|bordered|plain)$/]",
        "message": "<Button> variant must be one of 'prominent' | 'bordered' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeepLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|title|children|external|style|key|ref|className|style|children)$/]",
        "message": "<DeepLink> doesn't accept that prop. Declared props: href, title, children, external, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:glyph|title|message|actionLabel|onAction|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: glyph, title, message, actionLabel, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ErrorCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|tone|message|fixKey|style|key|ref|className|style|children)$/]",
        "message": "<ErrorCard> doesn't accept that prop. Declared props: name, tone, message, fixKey, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ErrorCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:error|auth|stale)$/]",
        "message": "<ErrorCard> tone must be one of 'error' | 'auth' | 'stale'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterHint'] > JSXAttribute > JSXIdentifier[name!=/^(?:keys|style|key|ref|className|style|children)$/]",
        "message": "<FooterHint> doesn't accept that prop. Declared props: keys, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeaderBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:product|updatedAt|refresh|updating|style|key|ref|className|style|children)$/]",
        "message": "<HeaderBar> doesn't accept that prop. Declared props: product, updatedAt, refresh, updating, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|label|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|value|accessory|chevron|onPress|isLast|style|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: title, subtitle, value, accessory, chevron, onPress, isLast, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MiniIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|title|size|fallback|style|key|ref|className|style|children)$/]",
        "message": "<MiniIcon> doesn't accept that prop. Declared props: src, alt, title, size, fallback, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MobileNavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|eyebrow|onBack|backLabel|trailing|style|key|ref|className|style|children)$/]",
        "message": "<MobileNavBar> doesn't accept that prop. Declared props: title, eyebrow, onBack, backLabel, trailing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaceIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|compact|style|key|ref|className|style|children)$/]",
        "message": "<PaceIndicator> doesn't accept that prop. Declared props: label, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|borderColor|radius|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, subtitle, borderColor, radius, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProviderCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|windows|warning|badge|badgeTone|offline|compact|cells|style|key|ref|className|style|children)$/]",
        "message": "<ProviderCard> doesn't accept that prop. Declared props: name, windows, warning, badge, badgeTone, offline, compact, cells, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProviderCard'] > JSXAttribute[name.name='badgeTone'] > Literal[value!=/^(?:live|cached|offline|stale|warning|error)$/]",
        "message": "<ProviderCard> badgeTone must be one of 'live' | 'cached' | 'offline' | 'stale' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Shield'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|tone|style|key|ref|className|style|children)$/]",
        "message": "<Shield> doesn't accept that prop. Declared props: label, value, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Shield'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|ok|warn|critical|accent)$/]",
        "message": "<Shield> tone must be one of 'neutral' | 'ok' | 'warn' | 'critical' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|dotColor|value|unit|bar|chips|meta|pace|badge|badgeTone|warning|hero|onPress|style|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: title, dotColor, value, unit, bar, chips, meta, pace, badge, badgeTone, warning, hero, onPress, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='badgeTone'] > Literal[value!=/^(?:live|cached|offline|stale|warning|error)$/]",
        "message": "<StatTile> badgeTone must be one of 'live' | 'cached' | 'offline' | 'stale' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|boxed|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: tone, children, boxed."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:live|cached|offline|stale|warning|error)$/]",
        "message": "<StatusBadge> tone must be one of 'live' | 'cached' | 'offline' | 'stale' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|disabled|labelsHidden|style|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: label, checked, onChange, disabled, labelsHidden, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UsageBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:percent|variant|cells|height|color|style|key|ref|className|style|children)$/]",
        "message": "<UsageBar> doesn't accept that prop. Declared props: percent, variant, cells, height, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UsageBar'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:glyph|capsule)$/]",
        "message": "<UsageBar> variant must be one of 'glyph' | 'capsule'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UsageRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|percent|reset|pace|state|compact|cells|key|ref|className|style|children)$/]",
        "message": "<UsageRow> doesn't accept that prop. Declared props: label, percent, reset, pace, state, compact, cells."
      },
      {
        "selector": "JSXOpeningElement[name.name='UsageRow'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:usage|depleted|na)$/]",
        "message": "<UsageRow> state must be one of 'usage' | 'depleted' | 'na'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
