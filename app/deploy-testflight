#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
[[ $# -eq 1 && "$1" == "--attended" ]] || {
  echo "deploy-testflight: requires exactly --attended" >&2
  exit 64
}
[[ "$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null)" == "$ROOT" ]] || {
  echo "release-testflight: checkout root could not be verified" >&2
  exit 4
}

CENTRAL_ROOT="$ROOT/../apple_developer"
ADAPTER="$ROOT/.release/release-adapter.json"
# `release_tools` declares `requires-python = ">=3.11"`, and since
# apple_developer's `809c413` its `workflow.py` imports `datetime.UTC`, which
# 3.9 does not have. macOS `/usr/bin/python3` is 3.9, so invoking the central
# package with it dies at import. gradus's own scripts stay 3.9-compatible and
# keep using `/usr/bin/python3` deliberately (`96fee19`); this resolution
# applies only to invocations of the central package.
release_python() {
  local candidate
  # Absolute prefixes are listed alongside the PATH names on purpose: these
  # wrappers must work under a minimal PATH (Git hooks, launchd, and the
  # `release-testflight` tests all run them with `PATH=<stubs>:/bin:/usr/bin`),
  # which is what the previous hardcoded absolute interpreter satisfied.
  for candidate in \
    "${GRADUS_RELEASE_PYTHON:-}" \
    python3 python3.13 python3.12 python3.11 \
    /opt/homebrew/bin/python3 /usr/local/bin/python3 \
    /usr/bin/python3; do
    [[ -n "$candidate" ]] || continue
    candidate="$(command -v "$candidate" 2>/dev/null)" || continue
    "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null || continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}
PYTHON_BIN="$(release_python)" || {
  echo "release-testflight: no Python >= 3.11 is available for release_tools; set GRADUS_RELEASE_PYTHON" >&2
  exit 4
}
if [[ -x "${HOME:-}/.agent/bin/bws-secret-exec" ]]; then
  PATH="$HOME/.agent/bin:$PATH"
  export PATH
fi
[[ -f "$CENTRAL_ROOT/release_tools/__main__.py" && -f "$ADAPTER" ]] || {
  echo "release-testflight: central release_tools or adapter is unavailable" >&2
  exit 4
}

git_common_dir="$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || {
  echo "release-testflight: Git common directory is unavailable" >&2
  exit 4
}
[[ -d "$git_common_dir" ]] || {
  echo "release-testflight: Git common directory is unavailable" >&2
  exit 4
}
candidate="$(env PYTHONPATH="$CENTRAL_ROOT" "$PYTHON_BIN" -c '
import json, re, sys
from pathlib import Path
from release_tools.product_state import ProductState

try:
    state = ProductState.for_repository(
        Path(sys.argv[1]), "gradus-ios", non_git_home=".release-state"
    )
    pointer = state.home / "active-candidate.json"
    if pointer.is_symlink() or (pointer.exists() and not pointer.is_file()):
        raise ValueError("active-candidate-corrupt")
    active = state._active()
    if active is None:
        raise ValueError("active-candidate-missing")

    candidate = active.get("candidateId")
    if not isinstance(candidate, str) or not re.fullmatch(
        r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", candidate
    ):
        raise ValueError("active-candidate-invalid")

    candidate_directory = state.candidates_directory / candidate
    if candidate_directory.is_symlink() or not candidate_directory.is_dir():
        raise ValueError("candidate-directory-invalid")
    manifest = candidate_directory / "manifest.json"
    if manifest.is_symlink() or not manifest.is_file():
        raise ValueError("candidate-manifest-invalid")
    manifest_value = json.loads(manifest.read_text(encoding="utf-8"))
    if not isinstance(manifest_value, dict) or manifest_value.get("candidateId") != candidate:
        raise ValueError("candidate-manifest-identity-mismatch")
except Exception as exc:
    print(f"release-testflight: canonical deployment state is invalid: {exc}", file=sys.stderr)
    sys.exit(3)

print(candidate)
' "$ROOT")" || exit $?
readiness_manifest="$git_common_dir/release-state/gradus-ios/candidates/$candidate/manifest.json"

# Gradus records one candidate-bound owner acknowledgement in its project-local
# ledger.  Translate that already-approved record into the retired central
# walkthrough schema before release_tools (and therefore credentials) starts.
if ! env PYTHONPATH="$SCRIPT_DIR" "$PYTHON_BIN" - "$ROOT" "$git_common_dir" "$candidate" <<'PY'
import hashlib
import json
import os
import re
import stat
import sys
import tempfile
from collections.abc import Mapping
from pathlib import Path

from release_candidate.ledger import CandidateLedger
from release_candidate.walkthrough import validate_owner_review


class BridgeError(ValueError):
    pass


HEX64 = re.compile(r"^[0-9a-f]{64}$")


def canonical_bytes(value):
    return json.dumps(
        value, ensure_ascii=False, sort_keys=True, separators=(",", ":")
    ).encode("utf-8")


def read_regular(path):
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        raise BridgeError("required review evidence is unavailable") from exc
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise BridgeError("required review evidence is not a regular file")
        with os.fdopen(descriptor, "rb", closefd=False) as stream:
            return stream.read()
    finally:
        os.close(descriptor)


def load_object(raw, code):
    try:
        value = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise BridgeError(code) from exc
    if not isinstance(value, Mapping):
        raise BridgeError(code)
    return dict(value)


def verify_existing(path, expected):
    if path.is_symlink():
        raise BridgeError("central walkthrough review conflicts")
    actual = load_object(read_regular(path), "central walkthrough review conflicts")
    if actual != expected:
        raise BridgeError("central walkthrough review conflicts")


try:
    root = Path(sys.argv[1])
    common = Path(sys.argv[2])
    candidate = sys.argv[3]

    local_candidate = root / ".release-state" / "candidates" / candidate
    if local_candidate.is_symlink() or not local_candidate.is_dir():
        raise BridgeError("Gradus owner review is unavailable")
    ledger_path = root / ".release-state" / "candidate.json"
    review_path = local_candidate / "walkthrough-owner-review.json"
    if ledger_path.is_symlink() or review_path.is_symlink():
        raise BridgeError("Gradus owner review is symlinked")

    ledger_before = read_regular(ledger_path)
    review_before = read_regular(review_path)
    validated = validate_owner_review(CandidateLedger(ledger_path), review_path)
    if validated.get("candidateId") != candidate:
        raise BridgeError("Gradus owner review candidate does not match")
    if ledger_before != read_regular(ledger_path) or review_before != read_regular(review_path):
        raise BridgeError("Gradus owner review changed during validation")
    owner_approval_sha256 = hashlib.sha256(review_before).hexdigest()

    central_candidate = common / "release-state" / "gradus-ios" / "candidates" / candidate
    if central_candidate.is_symlink() or not central_candidate.is_dir():
        raise BridgeError("central candidate directory is unavailable")
    walkthrough_path = central_candidate / "walkthrough.json"
    if walkthrough_path.is_symlink():
        raise BridgeError("central walkthrough seal is symlinked")
    walkthrough = load_object(
        read_regular(walkthrough_path), "central walkthrough seal is invalid"
    )
    walkthrough_sha256 = walkthrough.get("walkthroughSha256")
    normalized = dict(walkthrough)
    normalized["walkthroughSha256"] = None
    computed_walkthrough_sha256 = hashlib.sha256(
        canonical_bytes(normalized) + b"\n"
    ).hexdigest()
    if (
        walkthrough.get("candidateId") != candidate
        or walkthrough.get("sealed") is not True
        or not isinstance(walkthrough_sha256, str)
        or not HEX64.fullmatch(walkthrough_sha256)
        or walkthrough_sha256 != computed_walkthrough_sha256
    ):
        raise BridgeError("central walkthrough seal is invalid")

    expected = {
        "formatVersion": 1,
        "candidateId": candidate,
        "walkthroughSha256": walkthrough_sha256,
        "ownerApprovalSha256": owner_approval_sha256,
        "reviewed": True,
    }
    destination = central_candidate / "walkthrough-review.json"
    if destination.exists() or destination.is_symlink():
        verify_existing(destination, expected)
    else:
        encoded = canonical_bytes(expected) + b"\n"
        descriptor, temporary = tempfile.mkstemp(
            prefix=".walkthrough-review.", dir=central_candidate
        )
        try:
            os.fchmod(descriptor, 0o400)
            with os.fdopen(descriptor, "wb") as stream:
                descriptor = -1
                stream.write(encoded)
                stream.flush()
                os.fsync(stream.fileno())
            try:
                os.link(temporary, destination, follow_symlinks=False)
            except FileExistsError:
                verify_existing(destination, expected)
            directory_descriptor = os.open(central_candidate, os.O_RDONLY)
            try:
                os.fsync(directory_descriptor)
            finally:
                os.close(directory_descriptor)
        finally:
            if descriptor >= 0:
                os.close(descriptor)
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass
        verify_existing(destination, expected)
except Exception:
    print("release-testflight: walkthrough owner review bridge is invalid", file=sys.stderr)
    sys.exit(3)
PY
then
  exit 3
fi

exec env PYTHONPATH="$CENTRAL_ROOT" READINESS_MANIFEST="$readiness_manifest" \
  "$PYTHON_BIN" -m release_tools testflight \
  --adapter "$ADAPTER" --repository "$ROOT" --upload --candidate "$candidate"
