<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.gradus-snapshot</string>
	<key>ProgramArguments</key>
	<array>
		<string>__GRADUS_WRAPPER_PATH__</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>120</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>__GRADUS_STDOUT_PATH__</string>
	<key>StandardErrorPath</key>
	<string>__GRADUS_STDERR_PATH__</string>
</dict>
</plist>
